{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mark-and-roll",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Tous les matins à 8 h UTC : relances newsletter (J+2, J+5) et demande de photo après livraison.
  "triggers": { "crons": ["0 8 * * *"] },
  // Garde les variables réglées dans le tableau de bord à chaque déploiement.
  "keep_vars": true,

  // Wrangler lance le build avant chaque déploiement et chaque test local :
  // aucun réglage de build n'est nécessaire dans le tableau de bord Cloudflare.
  "build": { "command": "npx vite build" },

  // Fichiers statiques servis en direct, tout le reste passe par le rendu serveur.
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none" },

  // Base de commandes (D1) et logos clients (KV), inclus dans l'offre gratuite.
  // Sans identifiant, Wrangler les crée au premier déploiement.
  // Les tables sont créées par le site lui-même au premier accès.
  "d1_databases": [{ "binding": "DB", "database_name": "mark-and-roll" }],
  "kv_namespaces": [{ "binding": "LOGOS" }],

  // Nom de domaine : Cloudflare crée le DNS et le certificat HTTPS tout seul.
  // www et l'adresse workers.dev (gardée active pour les anciens liens) renvoient vers marknroll.com (src/server.ts),
  // sauf /api/ (webhooks Stripe déjà déclarés sur l'ancienne adresse).
  // Emails de commande (Brevo) : adresse d'envoi validée dans Brevo et adresse qui reçoit les alertes.
  // La clé BREVO_API_KEY reste un secret, à régler dans Cloudflare.
  "vars": { "EMAIL_EXPEDITEUR": "hugo.cremades04@gmail.com", "EMAIL_ATELIER": "hugo.cremades04@gmail.com" },

  "workers_dev": true,
  "routes": [
    { "pattern": "marknroll.com", "custom_domain": true },
    { "pattern": "www.marknroll.com", "custom_domain": true }
  ]

  // Secrets (jamais ici) : STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ATELIER_CODE
  // À régler dans Cloudflare : Workers > mark-and-roll > Paramètres > Variables et secrets.
}
