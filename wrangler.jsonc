{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mark-and-roll",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Garde les variables réglées dans le tableau de bord à chaque déploiement.
  "keep_vars": true,

  // Wrangler lance le build avant chaque déploiement et chaque test local :
  // aucun réglage de build n'est nécessaire dans le tableau de bord Cloudflare.
  "build": { "command": "npx vite build" },

  // Fichiers statiques servis en direct, tout le reste passe par le rendu serveur.
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none" },

  // Base de commandes (D1) et logos clients (KV), inclus dans l'offre gratuite.
  // Sans identifiant, Wrangler les crée au premier déploiement.
  // Les tables sont créées par le site lui-même au premier accès.
  "d1_databases": [{ "binding": "DB", "database_name": "mark-and-roll" }],
  "kv_namespaces": [{ "binding": "LOGOS" }]

  // Secrets (jamais ici) : STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ATELIER_CODE
  // À régler dans Cloudflare : Workers > mark-and-roll > Paramètres > Variables et secrets.
}
